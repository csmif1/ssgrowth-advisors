---
export interface Props {
	success: string
	error: string
}

const { success, error } = Astro.props
---

<!-- Invisible copies of both messages share the grid cell, so the space is already there and nothing moves when one appears -->
<div class="grid text-small">
	<p class="col-start-1 row-start-1 max-w-none" role="status" aria-live="polite" data-form-status data-success={success} data-error={error}></p>
	<span class="col-start-1 row-start-1 invisible" aria-hidden="true">{success}</span>
	<span class="col-start-1 row-start-1 invisible" aria-hidden="true">{error}</span>
</div>

<script>
	// Forms marked data-formspree send in place and report back in their status line.
	// Without JavaScript they still post to Formspree, which shows its own thank-you page.
	const tones = { pending: 'text-body', success: 'text-accent-hover', error: 'text-red-700' }

	document.querySelectorAll('form[data-formspree]').forEach((form) => {
		const status = form.querySelector('[data-form-status]')
		let sending = false

		function show(message, tone) {
			status.classList.remove(...Object.values(tones))
			status.classList.add(tones[tone])
			status.textContent = message
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault()
			if (sending) return
			sending = true
			form.querySelectorAll('[aria-invalid]').forEach((field) => field.removeAttribute('aria-invalid'))
			show('Sending…', 'pending')

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				})

				if (response.ok) {
					form.reset()
					show(status.dataset.success, 'success')
					return
				}

				// Formspree names any field it rejects, e.g. { errors: [{ field: 'email', message: 'should be an email' }] }
				const data = await response.json().catch(() => ({}))
				const field = (data.errors || [])
					.map((err) => err.field && form.elements.namedItem(err.field))
					.find((el) => el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)

				if (field) {
					const label = field.labels[0]?.textContent.replace('*', '').trim().toLowerCase() || 'entry'
					field.setAttribute('aria-invalid', 'true')
					field.focus()
					show(`Check your ${label} and try again.`, 'error')
				} else {
					show(status.dataset.error, 'error')
				}
			} catch {
				show(status.dataset.error, 'error')
			} finally {
				sending = false
			}
		})
	})
</script>
